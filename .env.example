# GitHub personal access token (classic, scope: repo) — один на все репозитории
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Репозитории, за которыми следим, через запятую.
# У каждого можно задать свою базовую ветку через двоеточие: owner/repo:develop
# Без ветки — используется BASE_BRANCH.
REPOS=owner/repo1, owner/repo2:develop, owner/repo3

# Базовая ветка PR по умолчанию (для репозиториев без своей ветки в REPOS)
BASE_BRANCH=master

# Интервал опроса, минут
POLL_MINUTES=5

# Команда запуска Python (на Windows иногда "py")
PYTHON_CMD=python

# ---- Модель для pr-agent ----
# Какой локальный конфиг активен:
#   pr_agent.local.toml            — локальная Ollama (gpt-oss:20b, нужна GPU)
#   pr_agent.local.openrouter.toml — облако OpenRouter (GLM-5.3-Flash, ~$0.045/$0.14 за 1M токенов)
PR_AGENT_LOCAL_CONFIG=pr_agent.local.openrouter.toml
# Ключ OpenRouter (https://openrouter.ai/keys). Поставь на ключ лимит расходов в кабинете OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Пропускать draft-PR
SKIP_DRAFTS=true

# Таймаут одного запуска pr-agent, минут
CLI_TIMEOUT_MINUTES=20

# Команды pr-agent для каждого нового/обновлённого PR, по порядку.
# describe — саммари в описание PR, review — ревью-комментарий,
# improve — предложения по улучшению кода (ещё 1–3 запроса к модели на PR).
PR_AGENT_COMMANDS=describe,review,improve

# ---- Предварительный апрув ----
# После review без замечаний (нет ключевых проблем, нет замечаний по безопасности,
# рекомендация safe_to_merge) поллер ставит approve от владельца токена. Если следующее
# ревью находит проблемы — снимает его. GitHub не даёт апрувить собственные PR, поэтому
# для полноценной работы токен лучше выдать отдельному bot-аккаунту.
AUTO_APPROVE=false
# Не апрувить, если оценка усилий на ревью выше (1–5); 0 — не учитывать
AUTO_APPROVE_MAX_EFFORT=3

# ---- Недельный релиз-дайджест для бизнеса (weekly-summary.mjs) ----
# Включён ли автоматический запуск из поллера
WEEKLY_SUMMARY=true
# День недели (1 = пн … 7 = вс) и час, после которого собирать дайджест за прошлую неделю
WEEKLY_SUMMARY_DAY=1
WEEKLY_SUMMARY_HOUR=9
# Сколько раз пытаться получить саммари для всех PR, прежде чем собрать дайджест как есть
WEEKLY_SUMMARY_MAX_ATTEMPTS=3
# Куда складывать markdown-файлы (относительно папки бота или абсолютный путь)
RELEASE_NOTES_DIR=release-notes
# Чем считать дайджест: openrouter (ключ OPENROUTER_API_KEY выше) или ollama (локально)
SUMMARY_PROVIDER=openrouter
# Модель; пусто — по умолчанию z-ai/glm-5.3-flash для openrouter, gpt-oss:20b для ollama
SUMMARY_MODEL=
OLLAMA_URL=http://localhost:11434
SUMMARY_NUM_CTX=32768
# Глубина рассуждений gpt-oss: low/medium/high (пусто — не передавать параметр)
SUMMARY_THINK=low
SUMMARY_TIMEOUT_MINUTES=30
